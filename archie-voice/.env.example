# Identity / agent
# Must match the Redis user_state name (agent reads persona/city/lang by this):
ARCHIE_USER_NAME=Niko
# Base URL of the Django webapp (proxies to the agent + persists messages)
ARCHIE_API_BASE=http://localhost:8000
# ssml | gemini_tts  (gemini_tts keeps Gemini inline audio tags like [excited]
# and feeds them straight to the TTS; requires agent support for the format)
ARCHIE_RESPONSE_FORMAT=ssml

# Wake word (OpenWakeWord). Stage 1 uses the pretrained "hey_jarvis".
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.6
WAKE_INFERENCE_FRAMEWORK=onnx

# STT (faster-whisper, offline). First run downloads the model.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ru

# TTS via OpenRouter (/audio/speech).
OPENROUTER_API_KEY=
# Gemini TTS: Russian + emotion/intonation. 30 voices (Kore, Puck, Charon,
# Aoede, Zephyr, Fenrir, Leda, Orus, ...).
TTS_MODEL=google/gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
# Fallback with named voices if Gemini errors:
#   TTS_MODEL=x-ai/grok-voice-tts-1.0   TTS_VOICE=Eve

# Audio
# MIC_DEVICE=            # leave empty for system default, or set device index

# Session timing (seconds)
SILENCE_TIMEOUT_S=10
END_OF_SPEECH_SILENCE_S=1.5
MAX_UTTERANCE_S=15
